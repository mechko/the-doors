# Docker Compose Settings
DOMAIN=localhost
# Local Mac development only: uncomment to build app images from this checkout.
# Leave this unset on the Raspi so it keeps pulling GHCR images.
# COMPOSE_FILE=docker-compose.yml:docker-compose.local-build.yml

# Ports
# Use 80 and 443 for public Let's Encrypt certificates.
# HTTP_PORT=80
# HTTPS_PORT=443

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mrbs
MYSQL_USER=mrbs_user
MYSQL_PASSWORD=mrbs_password

# Environment variables for the Rust Auth Backend
DATABASE_URL=mysql://mrbs_user:mrbs_password@mysql:3306/mrbs
# Generate a random value, for example: openssl rand -base64 48
JWT_SECRET=
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info
DATABASE_CONNECT_RETRIES=60
DATABASE_CONNECT_RETRY_DELAY_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Endpoint to call the Homematic API (aka CCU-JACK API) for door operations
CCU_JACK_URL=https://xxx.xxx.xxx.xxx:2122
# Set to true only if CCU-JACK uses a self-signed certificate and the network risk is accepted.
CCU_JACK_ACCEPT_INVALID_CERTS=false

# Application Settings
TIME_WINDOW_BEFORE_BOOKING=600
TIME_WINDOW_AFTER_BOOKING=600
